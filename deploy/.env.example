# Settings for flock's owls in Docker Compose (compose.owls.yml).
#
# Save this file as .env in the same directory as the compose file, and fill
# in the first three values. Never commit .env: it holds the flock key.

# roost's address, from roost's admin, e.g. http://roost.example.org:30117
ROOST_URL=
# The flock key, from roost's admin.
FLOCK_KEY=
# Your name or handle. roost shows it next to your owls, so people know whom
# to ask about them.
OWL_OPERATOR=

# How many owls `docker compose up -d` runs.
OWLS=5
